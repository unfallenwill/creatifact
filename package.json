{
  "name": "openmmcli",
  "version": "0.0.0",
  "description": "Boilerplate for building CLI packages in TypeScript",
  "author": "yangshun",
  "license": "MIT",
  "type": "module",
  "bin": "dist/index.mjs",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "clean": "rimraf dist",
    "lint": "biome check src tsdown.config.ts vitest.config.ts",
    "format": "biome format --write src tsdown.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "smoke": "node dist/index.mjs --version",
    "qa": "npm run typecheck && npm run build && npm run test && npm run lint && npm run smoke",
    "prepublishOnly": "npm run qa"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^3.2.7",
    "rimraf": "^6.0.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  }
}
