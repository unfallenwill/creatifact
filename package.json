{
  "name": "creatifact",
  "version": "0.1.3",
  "description": "Agent-native multimodal creation executor with OCI artifact packaging and delivery",
  "author": "unfallenwill",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfallenwill/creatifact.git"
  },
  "bugs": {
    "url": "https://github.com/unfallenwill/creatifact/issues"
  },
  "homepage": "https://github.com/unfallenwill/creatifact#readme",
  "keywords": [
    "cli",
    "ai",
    "multimodal",
    "text-to-image",
    "text-to-video",
    "video-generation",
    "image-generation",
    "oci",
    "artifact",
    "agent"
  ],
  "bin": {
    "creatifact": "dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./providers": {
      "import": "./dist/providers/index.mjs",
      "types": "./dist/providers/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "clean": "rimraf dist",
    "lint": "biome check src scripts tsdown.config.ts vitest.config.ts",
    "format": "biome format --write src scripts tsdown.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "deps": "depcruise src --config",
    "smoke": "node dist/index.mjs --version",
    "qa": "npm run typecheck && npm run build && npm run test && npm run lint && npm run deps && npm run smoke",
    "prepublishOnly": "npm run qa"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^15.0.0",
    "ms": "^2.1.3",
    "neverthrow": "^8.2.0",
    "p-graph": "^2.0.0",
    "p-retry": "^8.0.0",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2",
    "tar-stream": "^3.2.0",
    "tinyglobby": "^0.2.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.12.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/tar-stream": "^3.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.2.0",
    "execa": "^10.0.1",
    "rimraf": "^6.0.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  }
}
