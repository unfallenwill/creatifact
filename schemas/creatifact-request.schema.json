{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/unfallenwill/creatifact/main/schemas/creatifact-request.schema.json",
  "title": "Creatifact request file",
  "description": "The JSON mirror of one creatifact command line, run via `creatifact -f <file>.json`. The 'command' field selects the command; the remaining fields map to its arguments exactly as the flags would, and command-line flags after the file override run.* fields. Orchestration (multi-step, dependency graph) lives in creatifact.json stages.",
  "$defs": {
    "single.run.text2text": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "run.text2text",
          "description": "Which command to run."
        },
        "$schema": {
          "description": "Optional schema reference (ignored).",
          "type": "string"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Provider id, optionally with model: 'zhipu' or 'zhipu/cogview-4'. Omit to use the default provider (config key defaults.run.provider)."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model id (overrides any model in 'provider')."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Text instruction or question (run.text2text / text2image / image2image / text2video / image2video / frames2video; optional for image2text / video2text)."
        },
        "system": {
          "type": "string",
          "minLength": 1,
          "description": "System prompt (run.text2text only)."
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Provider-specific options (passed as --opt k=v)."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Result OCI layout directory for packaging tasks (media always; text/embed opt-in with --tag). Resume / --no-pack: directory to save artifacts. Also used by build / pull."
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "Reference name for the result package (default run-output:latest). Media tasks pack by default; text/embed tasks pack only when tag/output is set. Also build's image reference."
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
