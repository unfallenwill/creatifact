{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/unfallenwill/openmmcli/main/schemas/openmm-build.schema.json",
  "title": "openmmcli build manifest",
  "description": "Describes an OCI image: annotations, base images to inherit, paths to copy, and a local assets directory.",
  "type": "object",
  "properties": {
    "annotations": {
      "description": "Manifest annotations (image metadata).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "from": {
      "description": "Registry reference(s) or local OCI layout path(s) whose layers are inherited in order.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ]
    },
    "copy": {
      "description": "Extract specific paths from a source image and add them as a new layer.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "paths"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "assets": {
      "description": "Local directory packed as the top layer (relative to this file).",
      "type": "string",
      "minLength": 1
    },
    "gen": {
      "description": "Generation recipe: task, provider, model, and parameters. Baked into the image config blob so `openmmcli generate <ref>` can run it. Never contains credentials.",
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "description": "Generation task.",
          "enum": [
            "text2text",
            "image2text",
            "video2text",
            "text2image",
            "image2image",
            "text2video",
            "image2video",
            "frames2video",
            "embed"
          ]
        },
        "provider": {
          "description": "Provider id, optionally with model: 'zhipu' or 'zhipu/cogview-4'.",
          "type": "string",
          "minLength": 1
        },
        "model": {
          "description": "Model id (overrides any model in 'provider').",
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "description": "Default prompt (overridable via the positional prompt at generate time).",
          "type": "string"
        },
        "system": {
          "description": "System prompt (text2text only).",
          "type": "string"
        },
        "options": {
          "description": "Provider-specific generation options.",
          "type": "object"
        },
        "images": {
          "description": "Reference image(s): http(s)/data URL, local path, or pkg://path into this package's layers (packed via assets).",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "firstFrame": {
          "description": "frames2video only: first frame image (URL, local path, or pkg://path).",
          "type": "string",
          "minLength": 1
        },
        "lastFrame": {
          "description": "frames2video only: last frame image (URL, local path, or pkg://path).",
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "description": "Media attachments (image2text/video2text) or texts (embed): URL, local path, pkg://path, or plain text.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
