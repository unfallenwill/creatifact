{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "annotations": {
      "description": "Manifest annotations (image metadata).",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "from": {
      "description": "Registry reference(s) or local OCI layout path(s) whose layers are inherited in order.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {}
        }
      ]
    },
    "copy": {
      "description": "Extract specific paths from a source image and add them as a new layer.",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "from",
          "paths"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "description": "Local directory packed as the top layer (relative to this file).",
      "type": "string",
      "minLength": 1
    },
    "gen": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": [
            "text2text",
            "image2text",
            "video2text",
            "text2image",
            "image2image",
            "text2video",
            "image2video",
            "frames2video",
            "embed"
          ],
          "description": "Generation task."
        },
        "provider": {
          "description": "Provider id, optionally with model: 'zhipu' or 'zhipu/cogview-4'.",
          "type": "string",
          "minLength": 1
        },
        "model": {
          "description": "Model id (overrides any model in 'provider').",
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "description": "Default prompt (overridable via the positional prompt at generate time).",
          "type": "string",
          "minLength": 1
        },
        "promptFile": {
          "description": "Authoring convenience: read the prompt from this file (relative to the manifest), inlined into 'prompt' at load time. Never reaches built artifacts; mutually exclusive with 'prompt'.",
          "type": "string",
          "minLength": 1
        },
        "promptRef": {
          "description": "Provenance for a prompt produced by an earlier pipeline step: {name?, digest?, tag?}. digest anchors the source package content-addressedly.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "inputRefs": {
          "description": "Provenance for media inputs that referenced an earlier step's artifacts: the URL sent to the provider expires, the digest anchors the source package that still holds the bytes.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": [
                  "images",
                  "firstFrame",
                  "lastFrame",
                  "inputs"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "digest": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "field",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "system": {
          "description": "System prompt (text2text only).",
          "type": "string",
          "minLength": 1
        },
        "images": {
          "description": "Reference image(s): http(s)/data URL, local path, or pkg://path into this package's layers (packed via assets).",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "firstFrame": {
          "description": "frames2video only: first frame image (URL, local path, or pkg://path).",
          "type": "string",
          "minLength": 1
        },
        "lastFrame": {
          "description": "frames2video only: last frame image (URL, local path, or pkg://path).",
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "description": "Media attachments (image2text/video2text) or texts (embed): URL, local path, pkg://path, or plain text.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "options": {
          "description": "Provider-specific generation options.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "task"
      ],
      "additionalProperties": {},
      "description": "Generation section (RUN): executed during build (unless --plan) — pkg:// refs resolve against the layers above; artifacts become the top layer and the config records the executed spec. Never contains credentials."
    }
  },
  "required": [
    "gen"
  ],
  "additionalProperties": {},
  "$id": "https://raw.githubusercontent.com/unfallenwill/creatifact/main/schemas/creatifact-build.schema.json",
  "title": "Creatifact build manifest",
  "description": "Describes an OCI image: annotations, base images to inherit, paths to copy, and a local assets directory."
}
